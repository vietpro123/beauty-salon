{
  "name": "Booking",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string",
      "format": "email"
    },
    "client_phone": {
      "type": "string"
    },
    "service_slug": {
      "type": "string"
    },
    "stylist_slug": {
      "type": "string"
    },
    "requested_date": {
      "type": "string",
      "format": "date"
    },
    "requested_time": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled"
      ],
      "default": "pending"
    }
  },
  "required": [
    "client_name",
    "client_email"
  ]
}