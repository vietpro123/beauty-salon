{
  "name": "Service",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "hair",
        "nails",
        "skin"
      ]
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "long_description": {
      "type": "string"
    },
    "starting_price": {
      "type": "number"
    },
    "duration_minutes": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "preparation_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "slug",
    "name",
    "category"
  ]
}