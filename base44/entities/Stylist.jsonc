    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "bio": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "portrait_url": {
      "type": "string"
    },
    "portrait_color_url": {
      "type": "string"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "years_experience": {
      "type": "number"
    },
    "display_order": {
      "type": "number",
