{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    }
  },
  "required": [
    "client_name",
    "quote"
  ]
}